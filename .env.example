# ==============================================================================
# AI Social Media Publisher — Sanitized Environment Template
# Copy to .env ONLY for optional overrides, OR configure securely via:
#   npm run setup   OR   http://127.0.0.1:4815 (Local Setup UI)
# NEVER commit .env or paste real secrets into chat!
# ==============================================================================

# Local Backend Server (restricted strictly to loopback 127.0.0.1)
PORT=4815
HOST=127.0.0.1
APP_BASE_URL=http://127.0.0.1:4815
LOG_LEVEL=info

# Default Publishing Mode: "review" (wait for approval) or "autopilot"
DEFAULT_PUBLISH_MODE=review

# Video Discovery Directories (semicolon or comma separated; ~ expands to user home)
VIDEO_WATCH_DIRS=~/flow-mcp-out;~/WhiteboardFilms/films;~/StickFilms/films;~/Videos

# Media & FFmpeg Paths (leave blank to use system PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# ------------------------------------------------------------------------------
# OAuth & Platform Integrations (prefer storing in the encrypted local vault!)
# ------------------------------------------------------------------------------
# YouTube Data API v3 (Google Cloud Console -> OAuth 2.0 Web Client)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:4815/api/accounts/oauth/callback/youtube

# Instagram Graph API (Meta for Developers -> Unified Login / Facebook Login for Business)
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_API_VERSION=v22.0
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:4815/api/accounts/oauth/callback/instagram
# Supported modes: meta_unified_login (recommended), facebook_login (legacy), instagram_login (legacy)
INSTAGRAM_LOGIN_MODE=meta_unified_login

# ------------------------------------------------------------------------------
# Temporary Cloud Media Hosting Adapter (required for official Instagram Reels)
# Defaults to Cloudflare R2 (Standard storage only, private bucket, short-lived URLs)
# Strict application-level cost safeguards (NOT a Cloudflare billing cap)
# ------------------------------------------------------------------------------
TEMP_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REGION=auto
TEMP_MEDIA_URL_TTL_SECONDS=1800
TEMP_MEDIA_RETENTION_MINUTES=60
R2_MAX_TOTAL_STORED_BYTES=8589934592
R2_MAX_VIDEO_SIZE_BYTES=524288000
R2_ABANDONED_UPLOAD_HOURS=24
MAX_QUEUED_JOBS=10
R2_MONTHLY_UPLOAD_LIMIT_COUNT=200
R2_MONTHLY_UPLOAD_LIMIT_MB=10240

# ------------------------------------------------------------------------------
# AI Metadata Generation Providers (optional — uses first available provider)
# ------------------------------------------------------------------------------
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Optional local Whisper CLI path for offline audio transcription
WHISPER_CLI_PATH=
WHISPER_MODEL_PATH=

